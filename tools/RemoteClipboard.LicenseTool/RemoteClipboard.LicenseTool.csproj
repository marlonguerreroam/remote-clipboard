<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Author-only tool: generates the licensing key pair and issues license keys. The private key it
    creates must stay on the author's computer (it is never committed: *.pem is git-ignored).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LicenseTool</AssemblyName>
    <RootNamespace>RemoteClipboard.LicenseTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RemoteClipboard.Core\RemoteClipboard.Core.csproj" />
  </ItemGroup>
</Project>

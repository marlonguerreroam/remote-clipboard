root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,props,targets,csproj,xml,yml,yaml,xaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:silent
dotnet_style_readonly_field = true:warning
# Library code: no implicit sync-context capture.
dotnet_diagnostic.CA2007.severity = none
# Logging uses source-generated LoggerMessage; plain string logging is discouraged.
dotnet_diagnostic.CA1848.severity = warning
# Log arguments here are cheap property reads; not worth IsEnabled guards.
dotnet_diagnostic.CA1873.severity = suggestion
# Every source file carries the copyright and license header (enforced at build time).
file_header_template = Copyright (c) 2026 Marlon Andrés Guerrero Meriño\nSPDX-License-Identifier: GPL-3.0-only
dotnet_diagnostic.IDE0073.severity = warning

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-independent core: domain model, wire protocol, security primitives,
    pairing and synchronization logic. No Windows APIs here, so it is fully
    testable on any OS (including Linux CI).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RemoteClipboard.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemoteClipboard.Core.Tests" />
  </ItemGroup>
</Project>

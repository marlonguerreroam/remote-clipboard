<Window x:Class="RemoteClipboard.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RemoteClipboard.App.Views"
        Title="Remote Clipboard" Width="520" Height="640" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <views:EnumEqualsConverter x:Key="EnumEquals" />
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="2,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Remote Clipboard" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap">
          <Run Text="{Binding ThisDeviceName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ThisDeviceDetail, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <Button Grid.Column="1" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
              Style="{StaticResource GhostButton}" Padding="9,7" VerticalAlignment="Top"
              ToolTip="Configuración" Click="OnSettingsClick" />
    </Grid>

    <!-- Status -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,14,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource Muted}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                  <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusSubtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"
                  IsChecked="{Binding SyncEnabled, Mode=TwoWay}" ToolTip="Sincronización ON/OFF" />
      </Grid>
    </Border>

    <!-- Devices -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="DISPOSITIVOS" Style="{StaticResource SectionTitle}" />
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
        <Grid>
          <TextBlock Text="Todavía no hay dispositivos vinculados.&#x0a;Pulsa “Vincular dispositivo” en este equipo y en el otro."
                     Style="{StaticResource Caption}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                     Visibility="{Binding HasDevices, Converter={StaticResource InverseBoolToVisibility}}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Devices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="12,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="10" Height="10" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Muted}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                          <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DirectionText, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <ToggleButton Grid.Column="2" Content="Opciones" IsChecked="{Binding ShowOptions, Mode=TwoWay}" Cursor="Hand"
                                    Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Root" Background="Transparent" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,6">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleHover}" />
                              </Trigger>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtle}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>
                    </Grid>

                    <!-- Per-device options -->
                    <Grid Margin="24,10,0,2" Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVisibility}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton Content="Enviar y recibir" Style="{StaticResource Segment}" Padding="10,4"
                                       IsChecked="{Binding Direction, Converter={StaticResource EnumEquals}, ConverterParameter=Bidirectional}" />
                          <RadioButton Content="Solo enviar" Style="{StaticResource Segment}" Padding="10,4"
                                       IsChecked="{Binding Direction, Converter={StaticResource EnumEquals}, ConverterParameter=SendOnly}" />
                          <RadioButton Content="Solo recibir" Style="{StaticResource Segment}" Padding="10,4"
                                       IsChecked="{Binding Direction, Converter={StaticResource EnumEquals}, ConverterParameter=ReceiveOnly}" />
                        </StackPanel>
                      </Border>
                      <Button Grid.Column="1" Content="Desvincular" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Danger}"
                              Margin="8,0,0,0" Click="OnUnpairClick" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Actions -->
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ThisDeviceFingerprint}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="+  Vincular dispositivo" Style="{StaticResource PrimaryButton}" Click="OnPairClick" />
    </Grid>
  </Grid>
</Window>

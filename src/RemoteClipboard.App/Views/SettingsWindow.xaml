<Window x:Class="RemoteClipboard.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — Remote Clipboard" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
  <StackPanel Margin="24">
    <TextBlock Text="Configuración" Style="{StaticResource Title}" FontSize="22" Margin="0,0,0,16" />

    <TextBlock Text="ESTE EQUIPO" Style="{StaticResource SectionTitle}" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Nombre visible para los otros dispositivos" Style="{StaticResource Caption}" />
        <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="64" Margin="0,4,0,4" />
        <TextBlock x:Name="NameHint" Style="{StaticResource Caption}" />

        <CheckBox x:Name="DiscoveryBox" Style="{StaticResource Switch}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Visible en la red local" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Permite que otros equipos te encuentren sin escribir la IP (UDP 47810)."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="320" />
          </StackPanel>
        </CheckBox>

        <TextBlock Text="Puerto TCP" Style="{StaticResource Caption}" Margin="0,14,0,0" />
        <TextBox x:Name="PortBox" Style="{StaticResource Input}" MaxLength="5" Width="110" HorizontalAlignment="Left" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <TextBlock Text="APARIENCIA Y ARRANQUE" Style="{StaticResource SectionTitle}" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Tema" Style="{StaticResource Caption}" Margin="0,0,0,6" />
        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeSystem" Content="Sistema" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemePreview" />
            <RadioButton x:Name="ThemeLight" Content="Claro" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemePreview" />
            <RadioButton x:Name="ThemeDark" Content="Oscuro" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemePreview" />
          </StackPanel>
        </Border>
        <CheckBox x:Name="AutoStartBox" Content="Iniciar con Windows" Style="{StaticResource Switch}" Margin="0,14,0,0" />
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="Abrir registros" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnOpenLogs" />
      <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
      <Button Grid.Column="2" Content="Guardar" Style="{StaticResource PrimaryButton}" Click="OnSave" IsDefault="True" />
    </Grid>

    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" Margin="2,10,0,0" TextWrapping="Wrap" />
    <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" Margin="2,14,0,0" TextWrapping="Wrap" />
  </StackPanel>
</Window>

<UserControl x:Class="RemoteClipboard.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Configuración" Style="{StaticResource Title}" FontSize="26" Margin="0,0,0,20" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="ESTE EQUIPO" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="Nombre visible para los otros dispositivos" Style="{StaticResource Caption}" FontSize="13" />
            <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="64" Margin="0,6,0,4" MaxWidth="420" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="NameHint" Style="{StaticResource Caption}" />

            <CheckBox x:Name="DiscoveryBox" Style="{StaticResource Switch}" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="Visible en la red local" Foreground="{DynamicResource TextPrimary}" FontSize="14" />
                <TextBlock Text="Permite que otros equipos te encuentren sin escribir la IP (UDP 47810)."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
              </StackPanel>
            </CheckBox>

            <TextBlock Text="Puerto TCP" Style="{StaticResource Caption}" FontSize="13" Margin="0,18,0,0" />
            <TextBox x:Name="PortBox" Style="{StaticResource Input}" MaxLength="5" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="APARIENCIA Y ARRANQUE" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="22">
          <StackPanel>
            <TextBlock Text="Tema" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,8" />
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeSystem" Content="Sistema" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemePreview" />
                <RadioButton x:Name="ThemeLight" Content="Claro" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemePreview" />
                <RadioButton x:Name="ThemeDark" Content="Oscuro" GroupName="Theme" Style="{StaticResource Segment}" Checked="OnThemePreview" />
              </StackPanel>
            </Border>
            <CheckBox x:Name="AutoStartBox" Style="{StaticResource Switch}" Margin="0,18,0,0">
              <TextBlock Text="Iniciar con Windows" Foreground="{DynamicResource TextPrimary}" FontSize="14" />
            </CheckBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Rectangle Grid.ColumnSpan="3" Style="{StaticResource Divider}" Margin="0,0,0,16" />
      <TextBlock x:Name="MessageText" Grid.Row="1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,12,0" />
      <Button Grid.Row="1" Grid.Column="1" Content="Descartar cambios" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnDiscard" />
      <Button Grid.Row="1" Grid.Column="2" Content="Guardar" Style="{StaticResource PrimaryButton}" Padding="26,10" Click="OnSave" />
    </Grid>
  </Grid>
</UserControl>

<Window x:Class="RemoteClipboard.App.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincular dispositivo" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
  <StackPanel Margin="24">
    <TextBlock Text="Vincular dispositivo" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,18"
               Text="Haz esto en los dos equipos: uno muestra el código y el otro lo introduce." />

    <!-- Mode selector -->
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="ShowModeButton" Content="Mostrar código" Click="OnShowMode" />
      <Button x:Name="EnterModeButton" Grid.Column="2" Content="Introducir código" Click="OnEnterMode" />
    </Grid>

    <!-- Show code -->
    <Border x:Name="ShowPanel" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Código de vinculación" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
        <TextBlock x:Name="CodeText" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center"
                   FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,6" />
        <TextBlock x:Name="AddressText" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="ExpiryText" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <Button x:Name="NewCodeButton" Content="Generar nuevo código" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnNewCode" />
      </StackPanel>
    </Border>

    <!-- Enter code -->
    <Border x:Name="EnterPanel" Style="{StaticResource Card}" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="Dirección del otro equipo (IP o IP:puerto)" Style="{StaticResource Caption}" />
        <TextBox x:Name="AddressBox" Style="{StaticResource Input}" Margin="0,4,0,12" />
        <TextBlock Text="Código mostrado en el otro equipo" Style="{StaticResource Caption}" />
        <TextBox x:Name="CodeBox" Style="{StaticResource Input}" MaxLength="9" FontFamily="Cascadia Mono, Consolas"
                 FontSize="20" Margin="0,4,0,16" KeyDown="OnCodeKeyDown" />
        <Button x:Name="PairButton" Content="Vincular" Style="{StaticResource PrimaryButton}" Click="OnPair" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="2,14,0,0" FontWeight="SemiBold" />
  </StackPanel>
</Window>

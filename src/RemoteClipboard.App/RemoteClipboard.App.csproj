<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Per-user-session tray application (composition root). WPF for the UI,
    WinForms only for NotifyIcon (system tray).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RemoteClipboard.App</RootNamespace>
    <AssemblyName>RemoteClipboard</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, etc. Import WinForms explicitly where needed. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by tools/generate-icon.py -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- License of the app and of the bundled third-party components, shipped next to the executable. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemoteClipboard.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteClipboard.Core\RemoteClipboard.Core.csproj" />
    <ProjectReference Include="..\RemoteClipboard.Windows\RemoteClipboard.Windows.csproj" />
  </ItemGroup>
</Project>

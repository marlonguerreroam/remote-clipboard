<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Liquid glass, light. Surfaces are translucent white over a soft colored ambience; on Windows 11 the
       window itself is a system acrylic backdrop (ThemeManager swaps WindowBackground for WindowTint). -->
  <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F4F7FC" Offset="0" />
    <GradientStop Color="#E9EEF7" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="WindowTint" Color="#8CF5F7FB" />
  <!-- Two soft color glows behind the glass surfaces. -->
  <RadialGradientBrush x:Key="AmbienceA" Center="0.92,0.0" GradientOrigin="0.92,0.0" RadiusX="0.8" RadiusY="0.65">
    <GradientStop Color="#5C7AA7FF" Offset="0" />
    <GradientStop Color="#007AA7FF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbienceB" Center="0.04,1.0" GradientOrigin="0.04,1.0" RadiusX="0.75" RadiusY="0.6">
    <GradientStop Color="#4AB79CFF" Offset="0" />
    <GradientStop Color="#00B79CFF" Offset="1" />
  </RadialGradientBrush>

  <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C7FFFFFF" Offset="0" />
    <GradientStop Color="#94FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F2FFFFFF" Offset="0" />
    <GradientStop Color="#33A9B6CC" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="InputBackground" Color="#A6FFFFFF" />
  <!-- Raised glass: selected segment, switch thumb surface. -->
  <SolidColorBrush x:Key="GlassRaised" Color="#E6FFFFFF" />
  <SolidColorBrush x:Key="SubtleHover" Color="#59FFFFFF" />

  <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
  <SolidColorBrush x:Key="TextSecondary" Color="#5B6577" />
  <SolidColorBrush x:Key="Accent" Color="#2563EB" />
  <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
  <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3B82F6" Offset="0" />
    <GradientStop Color="#2563EB" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentSubtle" Color="#262563EB" />
  <SolidColorBrush x:Key="Success" Color="#16A34A" />
  <SolidColorBrush x:Key="Muted" Color="#A3ACBA" />
  <SolidColorBrush x:Key="Danger" Color="#DC2626" />
</ResourceDictionary>

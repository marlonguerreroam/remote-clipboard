<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Liquid glass, light: frosted blue-white glass. On Windows 11 the window is a system acrylic backdrop
       and ThemeManager swaps WindowBackground for the translucent WindowTint. Same keys as Dark.xaml. -->
  <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E3EDFB" Offset="0" />
    <GradientStop Color="#CFDEF4" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="WindowTint" Color="#73E6EFFC" />
  <!-- Two soft color glows behind the glass surfaces. -->
  <RadialGradientBrush x:Key="AmbienceA" Center="0.92,0.0" GradientOrigin="0.92,0.0" RadiusX="0.8" RadiusY="0.65">
    <GradientStop Color="#664D8DFF" Offset="0" />
    <GradientStop Color="#004D8DFF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbienceB" Center="0.04,1.0" GradientOrigin="0.04,1.0" RadiusX="0.75" RadiusY="0.6">
    <GradientStop Color="#4D7FD3F5" Offset="0" />
    <GradientStop Color="#007FD3F5" Offset="1" />
  </RadialGradientBrush>

  <!-- Large surfaces: sidebar (lighter glass) and main panel (denser glass). -->
  <SolidColorBrush x:Key="SidebarBackground" Color="#4DFFFFFF" />
  <LinearGradientBrush x:Key="PanelBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#A6FFFFFF" Offset="0" />
    <GradientStop Color="#80FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E6FFFFFF" Offset="0" />
    <GradientStop Color="#4DFFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Cards inside the main panel. -->
  <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D9FFFFFF" Offset="0" />
    <GradientStop Color="#B8FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFFFF" Offset="0" />
    <GradientStop Color="#40AFC3E0" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="InputBackground" Color="#B3FFFFFF" />
  <!-- Raised glass: selected segment, hover, icon tiles. -->
  <SolidColorBrush x:Key="GlassRaised" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="SubtleHover" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="NavSelected" Color="#B3D3E3FF" />
  <SolidColorBrush x:Key="DividerBrush" Color="#33718BB3" />
  <SolidColorBrush x:Key="MenuBackground" Color="#F7FAFDFF" />

  <SolidColorBrush x:Key="TextPrimary" Color="#0B1B3A" />
  <SolidColorBrush x:Key="TextSecondary" Color="#5A6A86" />
  <SolidColorBrush x:Key="Accent" Color="#2F6BFF" />
  <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
  <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#4D8DFF" Offset="0" />
    <GradientStop Color="#2563EB" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentSubtle" Color="#262F6BFF" />
  <SolidColorBrush x:Key="Success" Color="#22B35E" />
  <SolidColorBrush x:Key="Muted" Color="#A9B5C8" />
  <SolidColorBrush x:Key="Danger" Color="#DC2626" />
</ResourceDictionary>

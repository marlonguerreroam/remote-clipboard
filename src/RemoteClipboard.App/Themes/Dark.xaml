<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Liquid glass, dark: smoked blue glass. Same keys as Light.xaml. -->
  <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0C111C" Offset="0" />
    <GradientStop Color="#121A2B" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="WindowTint" Color="#A60A0F1A" />
  <RadialGradientBrush x:Key="AmbienceA" Center="0.92,0.0" GradientOrigin="0.92,0.0" RadiusX="0.8" RadiusY="0.65">
    <GradientStop Color="#552F6BFF" Offset="0" />
    <GradientStop Color="#002F6BFF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbienceB" Center="0.04,1.0" GradientOrigin="0.04,1.0" RadiusX="0.75" RadiusY="0.6">
    <GradientStop Color="#40229BD8" Offset="0" />
    <GradientStop Color="#00229BD8" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="SidebarBackground" Color="#0FFFFFFF" />
  <LinearGradientBrush x:Key="PanelBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1AFFFFFF" Offset="0" />
    <GradientStop Color="#0DFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#33FFFFFF" Offset="0" />
    <GradientStop Color="#0DFFFFFF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1FFFFFFF" Offset="0" />
    <GradientStop Color="#12FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3DFFFFFF" Offset="0" />
    <GradientStop Color="#0FFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="InputBackground" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="GlassRaised" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="SubtleHover" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="NavSelected" Color="#403B82F6" />
  <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="MenuBackground" Color="#F51A2233" />

  <SolidColorBrush x:Key="TextPrimary" Color="#EEF3FB" />
  <SolidColorBrush x:Key="TextSecondary" Color="#97A3B8" />
  <SolidColorBrush x:Key="Accent" Color="#6AA2FF" />
  <SolidColorBrush x:Key="AccentHover" Color="#3B82F6" />
  <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#4D8DFF" Offset="0" />
    <GradientStop Color="#2563EB" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentSubtle" Color="#333B82F6" />
  <SolidColorBrush x:Key="Success" Color="#2FCB6E" />
  <SolidColorBrush x:Key="Muted" Color="#4B5567" />
  <SolidColorBrush x:Key="Danger" Color="#F87171" />
</ResourceDictionary>

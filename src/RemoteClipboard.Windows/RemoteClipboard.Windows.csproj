<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows platform adapters: Win32 clipboard listener/writer, DPAPI secret
    storage, auto-start, firewall helpers. Implements Core abstractions.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RemoteClipboard.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteClipboard.Core\RemoteClipboard.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
</Project>
